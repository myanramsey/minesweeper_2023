{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Minesweeper (M4 Silicon)",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17", 
                "-fcolor-diagnostics",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/minesweeper",
                "-I/opt/homebrew/include",
                "-L/opt/homebrew/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler for Apple Silicon"
        }
    ]
}